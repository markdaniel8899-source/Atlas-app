{
  "expo": {
    "name": "ATLAS",
    "slug": "atlas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "atlas",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030305",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.atlas.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#030305"
      },
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030305",
          "image": "./assets/icon.png",
          "imageWidth": 76
        }
      ],
      "expo-updates",
      "expo-secure-store",
      ["expo-notifications", { "color": "#cf9eff" }],
      [
        "react-native-android-widget",
        {
          "fonts": ["./assets/fonts/CreateFuture.otf"],
          "widgets": [
            {
              "name": "AtlasWidget",
              "label": "ATLAS — Streak & Rank",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "description": "Your study streak, level and rank at a glance.",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 0,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/e3da5166-3d70-4bfa-ae8f-0a703790c725",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e3da5166-3d70-4bfa-ae8f-0a703790c725"
      }
    },
    "owner": "markdaniel8899"
  }
}
